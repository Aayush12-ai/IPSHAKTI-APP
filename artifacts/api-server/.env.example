# ==========================================
# IP-SAKTI API SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Google Gemini AI API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: PostgreSQL Database URL for persistence
# DATABASE_URL=postgresql://username:password@localhost:5432/ipsakti
