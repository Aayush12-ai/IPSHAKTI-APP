# ==========================================
# IP-SAKTI ROOT ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=3000

# Google Gemini AI API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier
GEMINI_MODEL=gemini-2.0-flash

# Mobile API URL (when testing Expo Go on physical device)
# Set to your PC local IP, e.g., http://192.168.1.5:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
